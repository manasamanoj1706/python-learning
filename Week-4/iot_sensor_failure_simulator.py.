
import random
from datetime import datetime

class Sensor:
    def __init__(self, name, unit, min_value, max_value):
        self.name = name
        self.unit = unit
        self.min_value = min_value
        self.max_value = max_value

    def read_value(self):
        # Simulate normal and faulty sensor readings
        if random.random() < 0.2:
            return random.choice([
                None,
                random.uniform(-100, -50),
                random.uniform(150, 250)
            ])

        return round(
            random.uniform(self.min_value, self.max_value), 2
        )

    def analyze(self, value):
        if value is None:
            return "SENSOR FAILURE: No reading"

        if not self.min_value <= value <= self.max_value:
            return "WARNING: Abnormal reading"

        return "NORMAL"


def monitor_sensors(sensors):
    print("=" * 58)
    print("       IOT SENSOR FAILURE MONITORING SYSTEM")
    print("=" * 58)
    print("Timestamp:", datetime.now().strftime("%Y-%m-%d %H:%M:%S"))

    failures = 0
    warnings = 0

    for sensor in sensors:
        value = sensor.read_value()
        status = sensor.analyze(value)

        if value is None:
            display_value = "No data"
        else:
            display_value = f"{value} {sensor.unit}"

        print(f"\nSensor       : {sensor.name}")
        print(f"Reading      : {display_value}")
        print(f"Status       : {status}")

        if status.startswith("SENSOR FAILURE"):
            failures += 1
        elif status.startswith("WARNING"):
            warnings += 1

    print("\n" + "=" * 58)
    print("MONITORING SUMMARY")
    print("=" * 58)
    print("Total sensors :", len(sensors))
    print("Failures      :", failures)
    print("Warnings      :", warnings)
    print("Healthy       :", len(sensors) - failures - warnings)

    if failures or warnings:
        print("\nAction: Inspect the affected sensors.")
    else:
        print("\nAll sensors are operating within expected ranges.")


def main():
    sensors = [
        Sensor("Temperature Sensor", "°C", 0, 50),
        Sensor("Humidity Sensor", "%", 20, 90),
        Sensor("Air Quality Sensor", "ppm", 300, 1500),
        Sensor("Water Level Sensor", "cm", 0, 100),
        Sensor("Battery Voltage Sensor", "V", 3.0, 4.2)
    ]

    monitor_sensors(sensors)


if __name__ == "__main__":
    main()
