password = input("Enter your password: ")

has_digit = False
has_upper = False
has_lower = False
has_special = False

for char in password:
    if char.isdigit():
        has_digit = True
    elif char.isupper():
        has_upper = True
    elif char.islower():
        has_lower = True
    else:
        has_special = True

if len(password) >= 8 and has_digit and has_upper and has_lower and has_special:
    print("Strong password")
elif len(password) >= 6 and has_digit and (has_upper or has_lower):
    print("Medium password")
else:
    print("Weak password")