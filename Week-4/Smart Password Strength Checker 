
import string
import getpass


def analyze_password(password):
    score = 0
    suggestions = []

    if len(password) >= 8:
        score += 1
    else:
        suggestions.append("Use at least 8 characters.")

    if len(password) >= 12:
        score += 1

    if any(char.islower() for char in password):
        score += 1
    else:
        suggestions.append("Add lowercase letters.")

    if any(char.isupper() for char in password):
        score += 1
    else:
        suggestions.append("Add uppercase letters.")

    if any(char.isdigit() for char in password):
        score += 1
    else:
        suggestions.append("Include numbers.")

    if any(char in string.punctuation for char in password):
        score += 1
    else:
        suggestions.append("Add special characters.")

    if len(set(password)) < len(password) * 0.6:
        suggestions.append("Avoid repeating characters too often.")

    if score <= 2:
        strength = "WEAK"
    elif score <= 4:
        strength = "MODERATE"
    else:
        strength = "STRONG"

    return strength, suggestions, score


def main():
    print("=" * 35)
    print("   SMART PASSWORD ANALYZER")
    print("=" * 35)

    password = getpass.getpass("Enter a test password: ")

    strength, suggestions, score = analyze_password(password)

    print("\nPassword Analysis")
    print("-" * 25)
    print(f"Strength: {strength}")
    print(f"Score: {score}/6")

    if suggestions:
        print("\nSuggestions:")
        for suggestion in suggestions:
            print(f"- {suggestion}")
    else:
        print("Good job! All basic checks passed.")

    print("\nNote: This is a basic educational checker.")


if __name__ == "__main__":
    main()
