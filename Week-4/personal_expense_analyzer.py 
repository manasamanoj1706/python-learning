
import json
from datetime import datetime
from pathlib import Path

FILE = Path("expenses.json")


def load_expenses():
    if FILE.exists():
        try:
            return json.loads(FILE.read_text())
        except json.JSONDecodeError:
            return []
    return []


def save_expenses(expenses):
    FILE.write_text(json.dumps(expenses, indent=4))


def add_expense(expenses):
    category = input("Category (Food/Travel/Shopping/Other): ").strip()
    description = input("Description: ").strip()

    try:
        amount = float(input("Amount spent (₹): "))
        if amount <= 0:
            print("Amount must be greater than zero.")
            return
    except ValueError:
        print("Please enter a valid amount.")
        return

    expenses.append({
        "date": datetime.now().strftime("%Y-%m-%d"),
        "category": category.title(),
        "description": description,
        "amount": round(amount, 2)
    })

    save_expenses(expenses)
    print("Expense saved successfully!")


def view_expenses(expenses):
    if not expenses:
        print("No expenses recorded yet.")
        return

    print("\n--- EXPENSE HISTORY ---")
    for item in expenses:
        print(
            f'{item["date"]} | {item["category"]} | '
            f'{item["description"]} | ₹{item["amount"]:.2f}'
        )


def spending_report(expenses):
    if not expenses:
        print("No data available for the report.")
        return

    total = sum(item["amount"] for item in expenses)
    categories = {}

    for item in expenses:
        category = item["category"]
        categories[category] = (
            categories.get(category, 0) + item["amount"]
        )

    print("\n--- SPENDING REPORT ---")
    print(f"Total spent: ₹{total:.2f}")

    for category, amount in sorted(
        categories.items(), key=lambda item: item[1], reverse=True
    ):
        print(f"{category}: ₹{amount:.2f} ({amount / total * 100:.1f}%)")


def main():
    expenses = load_expenses()

    while True:
        print("\n=== PERSONAL EXPENSE ANALYZER ===")
        print("1. Add expense")
        print("2. View expenses")
        print("3. Spending report")
        print("4. Exit")

        choice = input("Choose an option: ").strip()

        if choice == "1":
            add_expense(expenses)
        elif choice == "2":
            view_expenses(expenses)
        elif choice == "3":
            spending_report(expenses)
        elif choice == "4":
            print("Thank you for using Expense Analyzer!")
            break
        else:
            print("Invalid choice. Try again.")


if __name__ == "__main__":
    main()
