
import json
from datetime import datetime
from pathlib import Path

FILE = Path("memories.json")


def load_memories():
    if FILE.exists():
        try:
            return json.loads(FILE.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            print("Memory file is damaged. Starting fresh.")
    return []


def save_memories(memories):
    FILE.write_text(
        json.dumps(memories, indent=4, ensure_ascii=False),
        encoding="utf-8"
    )


def add_memory(memories):
    title = input("Memory title: ").strip()
    note = input("Write your memory: ").strip()

    if not title or not note:
        print("Title and memory cannot be empty!")
        return

    memories.append({
        "title": title,
        "note": note,
        "date": datetime.now().strftime("%d-%m-%Y %H:%M")
    })

    save_memories(memories)
    print("Your memory has been saved!")


def view_memories(memories):
    if not memories:
        print("Your memory jar is empty.")
        return

    for number, memory in enumerate(memories, start=1):
        print(f"\n{number}. {memory['title']}")
        print(f"   Date: {memory['date']}")
        print(f"   Memory: {memory['note']}")


def search_memories(memories):
    keyword = input("Enter a keyword: ").strip().lower()

    results = [
        memory for memory in memories
        if keyword in memory["title"].lower()
        or keyword in memory["note"].lower()
    ]

    if results:
        view_memories(results)
    else:
        print("No matching memories found.")


def main():
    memories = load_memories()

    while True:
        print("\n=== DIGITAL MEMORY JAR ===")
        print("1. Add a memory")
        print("2. View memories")
        print("3. Search memories")
        print("4. Exit")

        choice = input("Choose an option: ").strip()

        if choice == "1":
            add_memory(memories)
        elif choice == "2":
            view_memories(memories)
        elif choice == "3":
            search_memories(memories)
        elif choice == "4":
            print("Keep your beautiful memories safe!")
            break
        else:
            print("Invalid choice. Try again.")


if __name__ == "__main__":
    main()
