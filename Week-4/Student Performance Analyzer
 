
students = []

def calculate_grade(average):
    if average >= 90:
        return "A+"
    elif average >= 80:
        return "A"
    elif average >= 70:
        return "B"
    elif average >= 60:
        return "C"
    elif average >= 50:
        return "D"
    else:
        return "F"

def add_student():
    name = input("Enter student name: ")

    marks = []
    for i in range(1, 6):
        mark = float(input(f"Enter subject {i} mark: "))
        marks.append(mark)

    total = sum(marks)
    average = total / len(marks)
    grade = calculate_grade(average)

    status = "Pass" if all(m >= 35 for m in marks) else "Fail"

    student = {
        "name": name,
        "total": total,
        "average": average,
        "grade": grade,
        "status": status
    }

    students.append(student)

def display_report():
    print("\n===== STUDENT PERFORMANCE REPORT =====")

    for student in students:
        print("\nName:", student["name"])
        print("Total:", student["total"])
        print("Average:", round(student["average"], 2))
        print("Grade:", student["grade"])
        print("Result:", student["status"])

while True:
    print("\n1. Add Student")
    print("2. Display Report")
    print("3. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        add_student()
    elif choice == "2":
        display_report()
    elif choice == "3":
        print("Thank you!")
        break
    else:
        print("Invalid choice!")
