
import string
import getpass


def analyze_password(password):
    score = 0
    feedback = []

    checks = {
        "At least 8 characters": len(password) >= 8,
        "At least 12 characters": len(password) >= 12,
        "Contains uppercase letters": any(c.isupper() for c in password),
        "Contains lowercase letters": any(c.islower() for c in password),
        "Contains numbers": any(c.isdigit() for c in password),
        "Contains special symbols": any(
            c in string.punctuation for c in password
        )
    }

    print("\n--- PASSWORD SECURITY REPORT ---")

    for description, passed in checks.items():
        print(f"[{'✓' if passed else '✗'}] {description}")
        if passed:
            score += 1
        else:
            feedback.append(description)

    if password.lower() in {
        "password", "password123", "qwerty123", "admin123"
    }:
        score = min(score, 1)
        feedback.append("Avoid common passwords")

    print(f"\nSecurity score: {score}/6")

    if score <= 2:
        print("Strength: Weak")
    elif score <= 4:
        print("Strength: Moderate")
    else:
        print("Strength: Strong")

    if feedback:
        print("\nSuggestions:")
        for item in feedback:
            print(f"- {item}")

    print("\nTip: Use a unique password for every account.")


def main():
    print("=== PASSWORD STRENGTH ANALYZER ===")
    password = getpass.getpass("Enter a test password: ")

    if not password:
        print("Password cannot be empty.")
        return

    analyze_password(password)


if __name__ == "__main__":
    main()
