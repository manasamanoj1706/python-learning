# Simple Shopping Cart System

cart = []
total = 0

print("===== ONLINE SHOPPING =====")

while True:
    print("\n1. Add Product")
    print("2. View Cart")
    print("3. Remove Product")
    print("4. Checkout")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        product = input("Enter product name: ")
        price = float(input("Enter product price: "))

        cart.append((product, price))
        total += price

        print(product, "added to cart!")

    elif choice == "2":
        if len(cart) == 0:
            print("Your cart is empty.")
        else:
            print("\n--- Your Cart ---")

            for item in cart:
                print(item[0], "- ₹", item[1])

            print("Total: ₹", total)

    elif choice == "3":
        product = input("Enter product name to remove: ")

        found = False

        for item in cart:
            if item[0].lower() == product.lower():
                cart.remove(item)
                total -= item[1]
                found = True
                print(product, "removed from cart!")
                break

        if not found:
            print("Product not found.")

    elif choice == "4":
        if len(cart) == 0:
            print("Your cart is empty.")
        else:
            print("\n===== CHECKOUT =====")
            print("Total Amount: ₹", total)

            payment = input("Enter payment method (UPI/Card/Cash): ")

            print("Payment successful using", payment)
            print("Order placed successfully!")
            print("Thank you for shopping!")

            break

    elif choice == "5":
        print("Thank you! Visit again.")
        break

    else:
        print("Invalid choice. Try again.")