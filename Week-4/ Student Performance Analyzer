# Student Performance Analyzer

print("===== STUDENT PERFORMANCE ANALYZER =====")

students = {}

while True:
    print("\n1. Add Student")
    print("2. View Students")
    print("3. Find Top Student")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        name = input("Enter student name: ")

        try:
            marks = []
            subjects = ["Python", "Maths", "AI", "Data Science"]

            for subject in subjects:
                mark = float(input(f"Enter marks for {subject}: "))

                if mark < 0 or mark > 100:
                    raise ValueError("Marks must be between 0 and 100")

                marks.append(mark)

            average = sum(marks) / len(marks)

            if average >= 90:
                grade = "A+"
            elif average >= 80:
                grade = "A"
            elif average >= 70:
                grade = "B"
            elif average >= 60:
                grade = "C"
            else:
                grade = "D"

            students[name] = {
                "marks": marks,
                "average": average,
                "grade": grade
            }

            print(f"{name} added successfully!")

        except ValueError as error:
            print("Invalid input:", error)

    elif choice == "2":
        if not students:
            print("No students available.")
        else:
            print("\n===== STUDENT DETAILS =====")

            for name, data in students.items():
                print(f"\nName: {name}")
                print(f"Marks: {data['marks']}")
                print(f"Average: {data['average']:.2f}")
                print(f"Grade: {data['grade']}")

    elif choice == "3":
        if not students:
            print("No students available.")
        else:
            top_student = max(
                students,
                key=lambda name: students[name]["average"]
            )

            print("\n===== TOP STUDENT =====")
            print("Name:", top_student)
            print(
                "Average:",
                f"{students[top_student]['average']:.2f}"
            )
            print(
                "Grade:",
                students[top_student]["grade"]
            )

    elif choice == "4":
        print("Program closed.")
        break

    else:
        print("Invalid choice. Try again.")